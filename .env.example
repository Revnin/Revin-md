# Copy this file to .env and change the values you need.
BOT_NAME=Revin-MD
PREFIX=.
OWNER_NAME=Revin
OWNER_NUMBER=
TIMEZONE=Africa/Nairobi
ANTIDELETE=true
ANTIDELETE_DESTINATION=owner
STARTUP_NOTIFY=true
MENU_IMAGE_URL=https://imgur.com/a/KcGHbfW

# Optional downloader settings for future commands.
SONG_TIMEOUT_MS=45000
# Optional: path to a Netscape-format YouTube cookies file if YouTube requires sign-in.
# Keep the cookies file private and outside source control.
# SONG_COOKIES_FILE=/secure/path/youtube-cookies.txt
